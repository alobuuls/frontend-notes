 # =========================================
 # 🧠 ROOT
 # =========================================

root = true
 # 👉 Indica que este es el archivo principal
 # 👉 Evita que VS Code / editores busquen otros .editorconfig en carpetas superiores


 # =========================================
 # 🌍 CONFIG GLOBAL (TODOS LOS ARCHIVOS)
 # =========================================

[*]

charset = utf-8
 # 👉 Codificación estándar para soportar acentos, emojis y caracteres especiales

indent_style = space
 # 👉 Usa espacios en lugar de tabs (estándar moderno en JS/TS)

indent_size = 2
 # 👉 Número de espacios por nivel de indentación

tab_width = 2
 # 👉 Ancho visual de tabulaciones (mejora consistencia entre editores)

end_of_line = lf
 # 👉 Saltos de línea tipo Unix (recomendado para Git, Linux, CI/CD)

insert_final_newline = true
 # 👉 Siempre agrega una línea en blanco al final del archivo

trim_trailing_whitespace = true
 # 👉 Elimina espacios innecesarios al final de cada línea

max_line_length = 100
 # 👉 Longitud máxima recomendada por línea (no todos editores lo aplican)

quote_type = single
 # 👉 Preferencia de comillas simples (si el editor lo soporta)


 # =========================================
 # 🟡 JAVASCRIPT
 # =========================================

[*.js]

indent_size = 2
 # 👉 JS usa indentación estándar ligera

quote_type = single
 # 👉 Mantiene consistencia de comillas en JS


 # =========================================
 # 🔵 TYPESCRIPT
 # =========================================

[*.ts]

indent_size = 2
 # 👉 TS igual que JS para consistencia

quote_type = single
 # 👉 Evita mezcla de estilos de comillas


[*.tsx]

indent_size = 2
 # 👉 React + TypeScript

quote_type = single


 # =========================================
 # 🌐 HTML
 # =========================================

[*.html]

indent_size = 2
 # 👉 HTML más legible con indentación ligera

end_of_line = lf
 # 👉 Evita errores entre sistemas operativos

trim_trailing_whitespace = true
 # 👉 Limpia espacios innecesarios


 # =========================================
 # 🎨 CSS / STYLES
 # =========================================

[*.css]

indent_size = 2
 # 👉 CSS estándar moderno

[*.scss]

indent_size = 2
 # 👉 SCSS consistente con CSS

[*.less]

indent_size = 2
 # 👉 LESS mismo estándar


 # =========================================
 # 📄 JSON (CONFIGS IMPORTANTES)
 # =========================================

[*.json]

indent_size = 2
 # 👉 JSON legible y estándar

insert_final_newline = false
 # 👉 Algunos JSON requieren evitar newline final


 # =========================================
 # 🧾 MARKDOWN
 # =========================================

[*.md]

trim_trailing_whitespace = false
 # 👉 Evita romper formato en listas y docs

insert_final_newline = true
 # 👉 Mejora compatibilidad en docs

max_line_length = 80
 # 👉 Mejora lectura en documentación


 # =========================================
 # ⚙️ YAML / CONFIG FILES
 # =========================================

[*.yml]

indent_size = 2
 # 👉 YAML es sensible a indentación

[*.yaml]

indent_size = 2


 # =========================================
 # 🔐 ENV FILES
 # =========================================

[*.env]

insert_final_newline = true
 # 👉 Mantiene archivos de entorno limpios


 # =========================================
 # 🧪 TEST FILES
 # =========================================

[*.test.js]

indent_size = 2
 # 👉 Tests consistentes

[*.spec.js]

indent_size = 2

[*.test.ts]

indent_size = 2

[*.spec.ts]

indent_size = 2


 # =========================================
 # 🧩 FRAMEWORKS (ANGULAR / REACT)
 # =========================================

[*.component.ts]

indent_size = 2
 # 👉 Angular components

[*.module.ts]

indent_size = 2
 # 👉 Angular modules

[*.component.html]

indent_size = 2
 # 👉 Templates Angular


 # =========================================
 # 🧠 CONFIG FILES
# =========================================

[*.config.js]

indent_size = 2

[*.config.ts]

indent_size = 2


 # =========================================
 # 🚫 ARCHIVOS MINIFICADOS (NO TOCAR)
 # =========================================

[*.min.js]

indent_style = none
 # 👉 Archivos ya optimizados, no deben formatearse

[*.min.css]

indent_style = none
 # 👉 CSS minificado no debe modificarse